# =====================================================================
# KHTN 9 – PHYSICS AI · Biến môi trường
# Sao chép thành .env.local và điền giá trị. KHÔNG commit file .env.local.
# =====================================================================

# --- Supabase (bắt buộc) ---------------------------------------------
# Project Settings → API Keys. Chạy cục bộ: xem kết quả của `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
# Khóa publishable (sb_publishable_...) hoặc anon key (JWT cũ) – an toàn để lộ ở trình duyệt, RLS bảo vệ dữ liệu.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Khóa bí mật (sb_secret_... hoặc service_role) – CHỈ dùng phía máy chủ, bỏ qua RLS.
# Không bao giờ thêm tiền tố NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# (Tuỳ chọn) Khoá ký phiên học sinh vào học không mật khẩu. Để trống → dùng SUPABASE_SECRET_KEY.
# Đổi giá trị này sẽ đăng xuất toàn bộ học sinh.
STUDENT_SESSION_SECRET=

# --- AI (tuỳ chọn) ----------------------------------------------------
# Để trống → ứng dụng vẫn chạy, chức năng AI hiển thị "chưa được cấu hình".
# Giá trị hỗ trợ: anthropic | openai | gemini
AI_PROVIDER=
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
